#!/bin/sh
# unibox's installation runner. A Dockerfile puts it into the image with
#   COPY --from=unibox / /
# and runs the scripts it names, in order:
#   RUN @install base tools/nvm agents/claude custom
# Each name is a script of _shared/@install, the user's, or else of
# .shared/@install, unibox's: agents/claude runs agents/claude.sh. unibox
# merges the two into /usr/local/lib/unibox/install for the build. Names
# come as arguments, or one per line on stdin, so a heredoc lists them
# vertically; blank lines and #-comments pass. An executable script runs by
# its own shebang (nvm and sdkman need bash).
set -eu
dir=/usr/local/lib/unibox/install
run() {
    name="${1%.sh}"
    script="$dir/$name.sh"
    if [ ! -f "$script" ]; then
        echo "no installation script $name in _shared/@install or .shared/@install" >&2
        exit 1
    fi
    echo "installing $name"
    if [ -x "$script" ]; then
        "$script"
    else
        sh "$script"
    fi
}
if [ "$#" -gt 0 ]; then
    for name in "$@"; do run "$name"; done
else
    while read -r name; do
        case "$name" in '' | \#*) continue ;; esac
        run "$name"
    done
fi
