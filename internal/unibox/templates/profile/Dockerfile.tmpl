# The image is composed by @install: it runs the installation scripts it
# names, in order, each from _shared/@install, yours, or .shared/@install,
# unibox's; COPY --from=unibox puts it and them into the image. The sbx
# build passes BASE=docker/sandbox-templates:shell (.sbx/build.args).
ARG BASE=ubuntu:24.04
FROM ${BASE}

ARG UNIBOX_RUNTIME
USER root

COPY --from=unibox / /
RUN @install {{join .Installations " "}}

# The shell template ships an agent user; a plain ubuntu base needs one made.
RUN id agent >/dev/null 2>&1 || useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent
