# The image is composed by .shared/install.sh: list the installation scripts,
# one per line: each runs from _shared/@install, yours, or .shared/@install,
# unibox's. The sbx build passes BASE=docker/sandbox-templates:shell
# (.sbx/build.args); the default keeps this buildable by hand.
ARG BASE=ubuntu:24.04
FROM ${BASE}

ARG UNIBOX_RUNTIME
USER root

RUN --mount=type=bind,target=/unibox /unibox/.shared/install.sh <<EOF
{{range .Installations}}{{.}}
{{end}}EOF

# The shell template ships an agent user; a plain ubuntu base needs one made.
RUN id agent >/dev/null 2>&1 || useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent
